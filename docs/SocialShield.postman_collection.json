{
  "info": {
    "name": "SocialShield · contratos CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar completa sobre una base de pruebas con los niveles Básico, Intermedio y Avanzado. Crea datos ficticios y elimina sus seis recursos CRUD al finalizar; el reporte queda en la base de pruebas. No usa credenciales Google reales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080"
    },
    {
      "key": "runId",
      "value": "test"
    }
  ],
